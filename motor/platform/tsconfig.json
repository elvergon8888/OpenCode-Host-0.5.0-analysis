{
  "$comment": "Configuracion de type-check del contrato PlatformProvider (Fase 2). Solo analiza motor/platform/. No emite ficheros.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true
  },
  "include": ["Platform.ts", "contracts/**/*.ts"]
}
